# ==============================================================================
# Octo Flashcard Study — Environment Variables Template
# Copy this file to .env (or configure in your deployment pipeline / hosting service)
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend (.NET ASP.NET Core)
# In ASP.NET Core, nested JSON configuration keys use double underscore (__) in env vars.
# ------------------------------------------------------------------------------

# ASP.NET Core Environment (Development | Staging | Production)
ASPNETCORE_ENVIRONMENT=Production

# Database Connection String (MySQL)
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=OctoFlashcardStudyDb;User=root;Password=YOUR_SECURE_PASSWORD;

# JWT Authentication
# Key must be at least 32 characters (256-bit) for HMAC-SHA256
Jwt__Key=YOUR_MINIMUM_32_CHARACTER_JWT_SECRET_KEY_HERE_2026
Jwt__Issuer=OctoFlashcardStudy.API
Jwt__Audience=OctoFlashcardStudy.API
Jwt__ExpiresInMinutes=60

# Allowed CORS Origins (comma-separated or indexed array)
AllowedCorsOrigins__0=http://localhost:3000
AllowedCorsOrigins__1=https://your-production-domain.com

# ------------------------------------------------------------------------------
# Frontend (Next.js)
# ------------------------------------------------------------------------------

# Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:5062
